# ---- Core (FS runner fills these from secrets) ----
PORT=3000
# console | smtp | resend | sendgrid | brevo
EMAIL_PROVIDER=smtp
EMAIL_FROM="ElseMail <no-reply@elsemail.indevs.in>"
FRONTEND_URL=https://elsemail.indevs.in
APP_NAME=ElseMail

# ---- Service auth: full root access key (repo secret SERVICE_API_KEY) ----
SERVICE_API_KEY=change-me-strong-random-key
TEMP_OPEN=false

# ---- SMTP (local relay inside the runner) ----
SMTP_HOST=127.0.0.1
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# ---- Mail identity ----
MAIL_DOMAIN=elsemail.indevs.in
MAIL_HOSTNAME=elsemail.indevs.in
DKIM_SELECTOR=local
ENABLE_MX_DELIVERY=true
